# Shared editor settings (identical base in every Dialectic Playground repository).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,toml}]
indent_size = 4

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[{Makefile,BASE-MAKEFILE,*.mk,*.tmpl}]
indent_style = tab

# Repository-specific: test inputs, fixtures, and expected outputs are byte-exact.
# Editors must never reformat them.
[projects/*/tests/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
